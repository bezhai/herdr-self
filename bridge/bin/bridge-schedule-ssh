#!/bin/sh
# bridge-schedule on a machine that Bridge reaches over SSH, such as cpu2: Bridge takes the requests of agents only on a Unix socket on its
# own host, so this runs bridge-schedule there over ssh. This machine's name and the pane of the calling agent go first, then the
# arguments, all NUL-separated on stdin: the remote command line is fixed, so no quoting there can change a task text. Install it as
# bridge-schedule on the PATH of the agents and set the two values below (see Bridge's README).
# BRIDGE_HOST: how this machine reaches the Bridge host with ssh, such as an alias of ~/.ssh/config; it must log in without a prompt.
# BRIDGE_MACHINE: the name of this machine's connection in the Bridge console.
# BRIDGE_COMMAND: bridge-schedule on the Bridge host, relative to the home directory there or absolute.
BRIDGE_HOST=${BRIDGE_HOST:-}
BRIDGE_MACHINE=${BRIDGE_MACHINE:-}
BRIDGE_COMMAND=${BRIDGE_COMMAND:-.local/bin/bridge-schedule}
if [ -z "$BRIDGE_HOST" ] || [ -z "$BRIDGE_MACHINE" ]; then
 echo 'bridge-schedule: 请在这个脚本开头填写 BRIDGE_HOST 和 BRIDGE_MACHINE' >&2
 exit 2
fi
printf '%s\0' --machine "$BRIDGE_MACHINE" --pane "${HERDR_PANE_ID:-}" "$@" |
 ssh -T -o BatchMode=yes -o ConnectTimeout=10 -- "$BRIDGE_HOST" "$BRIDGE_COMMAND --stdin"
