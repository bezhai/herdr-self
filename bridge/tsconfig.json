// Node runs the .ts files as they are (see README): only syntax it can erase, imports with their .ts extension and type-only imports
// marked as such. tsc only checks them, and npm test runs it first.
{
  "compilerOptions": {
    "target": "es2025",
    // Node's globals (fetch, WebSocket) come from @types/node, not from the DOM library, which does not know the headers of Node's WebSocket.
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    // Bridge throws Errors that carry fields such as code, timedOut and created, and reads them where it catches one, as it does where a
    // promise rejects.
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // worktree-branch.mjs stays JavaScript, checked through its JSDoc: the worktree-task plugin imports it by that name.
    "allowJs": true,
    "skipLibCheck": true
  },
  // The modules typed so far; the others follow.
  "include": ["array-includes.d.ts", "state.ts", "core.ts", "link.ts", "machine.ts", "platform.ts", "commands.ts", "cot.ts", "request-cards.ts", "message-cards.ts",
    "attachments.ts", "cron.ts", "web-assets.ts", "skills.ts", "clients.ts", "registration.ts", "pending-chats.ts",
    "adoption.ts", "schedule-cards.ts", "worktree-branch.mjs", "worktrees.ts", "topics.ts", "schedules.ts", "agent-schedules.ts", "client.ts", "schedule-command.ts", "skill-command.ts", "console-state.ts", "server.ts", "bin/bridge-client.ts", "bin/bridge-schedule.ts", "bin/bridge-skill.ts"]
}
